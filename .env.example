DATABASE_URL=sqlite:///./real_estate.db
API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
LOG_LEVEL=INFO
WEB_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
DASHSCOPE_API_KEY=replace-with-your-api-key
QWEN_REALTIME_MODEL=qwen3.5-omni-flash-realtime
# Use "brevo" on Render Free. Register and verify BOOKING_FROM_EMAIL in Brevo first.
EMAIL_DELIVERY_MODE=brevo
BREVO_API_KEY=replace-with-your-brevo-api-key
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
BOOKING_FROM_EMAIL=verified-sender@example.com
BOOKING_FROM_NAME=Horizon Homes
# Optional Gmail SMTP mode for local development or a paid host.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail-address@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
SMTP_START_TLS=true
SMTP_USE_SSL=false
